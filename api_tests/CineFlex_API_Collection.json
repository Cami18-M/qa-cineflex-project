        {
          "name": "Reserva exitosa (compra)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const base = pm.environment.get('baseUrl');",
                  "const token = pm.environment.get('token');",
                  "pm.sendRequest({ url: base + '/peliculas/' + pm.environment.get('peliculaId') + '/asientos', method: 'GET', header: { 'Authorization': 'Bearer ' + token } }, function (err, res) { if (!err && res.code === 200) { const a = res.json().asientos || []; const libre = a.find(function (x) { return x.estado === 'libre'; }); if (libre) pm.environment.set('asientoLibre', libre.id); } });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('Reserva confirmada', function () { pm.expect(pm.response.json().estado).to.eql('CONFIRMADA'); });",
                  "pm.test('Ticket con codigo valido', function () { pm.expect(pm.response.json().codigoTicket).to.match(/^CF-\\d{6}$/); });",
                  "pm.test('Total mayor que cero', function () { pm.expect(pm.response.json().total).to.be.a('number').and.above(0); });",
                  "pm.test('Transaccion aprobada', function () { pm.expect(pm.response.json().transaccion.estado).to.eql('APROBADO'); });",
                  "pm.environment.set('reservaId', pm.response.json().reservaId);"
                ]
              }
            }
          ],
