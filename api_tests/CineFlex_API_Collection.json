{
  "info": {
    "name": "CineFlex API Collection",
    "description": "Coleccion de pruebas de API para la plataforma CineFlex (taller QA en produccion).\n\nRequisitos:\n- Backend corriendo en {{baseUrl}} (por defecto http://localhost:3000/api).\n- Ejecutar la carpeta completa en orden para que el login capture el token.\n- Se puede ejecutar con Newman: newman run CineFlex_API_Collection.json -e CineFlex_Environment.json",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Login",
      "item": [
        {
          "name": "Login valido (captura JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Respuesta con token JWT', function () { const t = pm.response.json().token; pm.expect(t).to.be.a('string').and.not.empty; pm.environment.set('token', t); });",
                  "pm.test('Respuesta con datos de usuario', function () { const u = pm.response.json().user; pm.expect(u).to.have.property('email').that.equals(pm.environment.get('email')); pm.expect(u).to.have.property('nombre').to.be.a('string'); });"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Login credenciales invalidas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado 401', function () { pm.response.to.have.status(401); });",
                  "pm.test('Mensaje de error correcto', function () { pm.expect(pm.response.json().error).to.include('Credenciales'); });",
                  "pm.test('No se emite token', function () { pm.expect(pm.response.json()).to.not.have.property('token'); });"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"incorrecta\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Login campos vacios",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado 400', function () { pm.response.to.have.status(400); });",
                  "pm.test('Mensaje de validacion', function () { pm.expect(pm.response.json().error).to.include('obligatorios'); });"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"\",\n  \"password\": \"\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "Bloqueo preventivo (3 intentos fallidos)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const baseUrl = pm.environment.get('baseUrl');",
                  "const email = 'bloqueo' + Date.now() + '@cineflex.com';",
                  "function attempt(pass, cb) { pm.sendRequest({ url: baseUrl + '/auth/login', method: 'POST', header: { 'Content-Type': 'application/json' }, body: { mode: 'raw', raw: JSON.stringify({ email: email, password: pass }) } }, function (err, res) { cb(res); }); }",
                  "attempt('mal1', function (r1) { attempt('mal2', function (r2) { attempt('mal3', function (r3) { attempt('mal4', function (r4) {",
                  "  pm.test('Intento 1 -> 401', function () { pm.expect(r1.code).to.eql(401); });",
                  "  pm.test('Intento 2 -> 401', function () { pm.expect(r2.code).to.eql(401); });",
                  "  pm.test('Intento 3 -> 429 (bloqueo)', function () { pm.expect(r3.code).to.eql(429); });",
                  "  pm.test('Intento 4 -> 429 (sigue bloqueado)', function () { pm.expect(r4.code).to.eql(429); });",
                  "  pm.test('Mensaje de bloqueo correcto', function () { pm.expect(r3.json().error).to.include('bloqueada'); });",
                  "  pm.test('Indica reintentarEnSegundos', function () { pm.expect(r3.json().reintentarEnSegundos).to.be.a('number').and.above(0); });",
                  "}); }); }); });"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"bloqueo@cineflex.com\",\n  \"password\": \"cualquiera\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Cartelera",
      "item": [
        {
          "name": "Cartelera valida (con token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Respuesta es JSON valido', function () { const data = pm.response.json(); pm.expect(data).to.have.property('peliculas'); });",
                  "pm.test('Lista de peliculas no vacia', function () { pm.expect(pm.response.json().peliculas).to.be.an('array').that.is.not.empty; });",
                  "pm.test('Cada pelicula tiene estructura correcta', function () { pm.response.json().peliculas.forEach(function (p) { pm.expect(p).to.have.property('titulo'); pm.expect(p).to.have.property('genero'); pm.expect(p).to.have.property('precio'); }); });",
                  "pm.test('Tiempo de respuesta < 300 ms', function () { pm.expect(pm.response.responseTime).to.be.below(300); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cartelera",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "cartelera"
              ]
            }
