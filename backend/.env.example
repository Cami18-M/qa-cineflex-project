# ============================================================
# CineFlex - Variables de entorno (EJEMPLO)
# Copia este archivo como ".env" y ajusta los valores.
# NUNCA subas el archivo ".env" real al repositorio.
# Todos los valores son ficticios y no exponen secretos reales.
# ============================================================

# Puerto del servidor
PORT=3000

# Secreto para firmar los JWT (solo para desarrollo/mock)
JWT_SECRET=cineflex_secreto_dev_no_usar_en_produccion
JWT_EXPIRES_IN=1h

# Politica de bloqueo de inicio de sesion
LOGIN_MAX_INTENTOS=3
LOGIN_BLOQUEO_SEG=60

# Entorno (development | test | production)
NODE_ENV=development
